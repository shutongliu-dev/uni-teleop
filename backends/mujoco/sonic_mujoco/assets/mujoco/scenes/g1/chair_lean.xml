<mujoco model="g1_chair_lean">
  <include file="common.xml"/>
  <include file="../../robots/g1/g1_29dof_with_hand.xml"/>

  <asset>
    <texture name="chair_scan_color" type="2d"
      file="../../textures/upholstered_chair_basecolor.png"/>
    <material name="floor_lab" rgba="0.46 0.48 0.49 1" reflectance="0.10"/>
    <material name="curtain" rgba="0.018 0.018 0.022 1"/>
    <material name="chair_visual" texture="chair_scan_color"
      specular="0.05" shininess="0.08"/>
    <material name="chair_collision" rgba="0.58 0.25 0.13 0"/>
    <mesh name="upholstered_chair_mesh"
      file="../../../meshes/upholstered_chair.obj"/>
  </asset>

  <default>
    <default class="chair_rigid">
      <geom density="0" friction="0.85 0.01 0.001"
        solref="0.015 1" solimp="0.9 0.95 0.002"
        material="chair_collision"/>
    </default>
    <default class="chair_soft">
      <geom density="0" friction="0.68 0.012 0.001"
        solref="0.035 1" solimp="0.82 0.95 0.008"
        material="chair_collision"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.3 -0.7 2.5" dir="0.1 0.2 -1" directional="true"
      diffuse="0.88 0.86 0.82"/>
    <light pos="1.4 0.9 1.8" dir="-0.3 -0.2 -1" directional="true"
      diffuse="0.42 0.42 0.44"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floor_lab"
      friction="1.0 0.01 0.001"/>
    <geom name="rear_curtain" type="box" pos="2.05 0 1.05"
      size="0.02 1.3 1.05" material="curtain" contype="0" conaffinity="0"/>

    <!-- Dimensions follow the reference chair: 56 cm overall width, 54 cm
         depth, 35 cm seat height, and 66 cm overall height. The chair is a
         free rigid body so hard impacts can move or tip it. -->
    <body name="chair" pos="1.45 0 0">
      <freejoint name="chair_joint"/>
      <inertial pos="-0.16 0 0.28" mass="11.0"
        diaginertia="0.54 0.42 0.48"/>
      <geom name="chair_visual" type="mesh" mesh="upholstered_chair_mesh"
        pos="-0.20 0 0" quat="0 0 0 1"
        material="chair_visual" density="0"
        contype="0" conaffinity="0"/>

      <geom name="chair_base" class="chair_rigid" type="box"
        pos="-0.24 0 0.255" size="0.25 0.28 0.065"
        material="chair_collision"/>
      <geom name="chair_seat" class="chair_soft" type="ellipsoid"
        pos="-0.235 0 0.315" size="0.215 0.235 0.035"
        material="chair_collision"/>

      <geom name="chair_arm_left" class="chair_soft" type="ellipsoid"
        pos="-0.18 0.255 0.43" size="0.235 0.045 0.12"
        material="chair_collision"/>
      <geom name="chair_arm_right" class="chair_soft" type="ellipsoid"
        pos="-0.18 -0.255 0.43" size="0.235 0.045 0.12"
        material="chair_collision"/>

      <geom name="chair_back_shell" type="ellipsoid"
        pos="0.030 0 0.505" size="0.055 0.28 0.17"
        quat="0.9962 0 0.0872 0" material="chair_collision"
        contype="0" conaffinity="0" density="0"/>
      <geom name="chair_back" class="chair_soft" type="ellipsoid"
        pos="-0.012 0 0.505" size="0.042 0.255 0.155"
        quat="0.9962 0 0.0872 0" material="chair_collision"/>

      <geom name="chair_leg_front_left" class="chair_rigid" type="capsule"
        fromto="-0.31 0.21 0.22 -0.39 0.245 0.035" size="0.021"
        material="chair_collision"/>
      <geom name="chair_leg_front_right" class="chair_rigid" type="capsule"
        fromto="-0.31 -0.21 0.22 -0.39 -0.245 0.035" size="0.021"
        material="chair_collision"/>
      <geom name="chair_leg_rear_left" class="chair_rigid" type="capsule"
        fromto="-0.09 0.21 0.22 -0.02 0.245 0.035" size="0.021"
        material="chair_collision"/>
      <geom name="chair_leg_rear_right" class="chair_rigid" type="capsule"
        fromto="-0.09 -0.21 0.22 -0.02 -0.245 0.035" size="0.021"
        material="chair_collision"/>
      <geom name="chair_foot_front_left" class="chair_rigid" type="sphere"
        pos="-0.39 0.245 0.025" size="0.025" material="chair_collision"
        friction="1.25 0.015 0.002"/>
      <geom name="chair_foot_front_right" class="chair_rigid" type="sphere"
        pos="-0.39 -0.245 0.025" size="0.025" material="chair_collision"
        friction="1.25 0.015 0.002"/>
      <geom name="chair_foot_rear_left" class="chair_rigid" type="sphere"
        pos="-0.02 0.245 0.025" size="0.025" material="chair_collision"
        friction="1.25 0.015 0.002"/>
      <geom name="chair_foot_rear_right" class="chair_rigid" type="sphere"
        pos="-0.02 -0.245 0.025" size="0.025" material="chair_collision"
        friction="1.25 0.015 0.002"/>
    </body>
  </worldbody>
</mujoco>
