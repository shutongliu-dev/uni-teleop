+    private static void HandleHapticImpulse(string value)
+    {
+        try
+        {
+            value = value.Replace("\\", "");
+            JsonData json = JsonMapper.ToObject(value);
+            float left = Mathf.Clamp01(float.Parse(
+                json["left"].ToString(), CultureInfo.InvariantCulture));
+            float right = Mathf.Clamp01(float.Parse(
+                json["right"].ToString(), CultureInfo.InvariantCulture));
+            int duration = Mathf.Clamp(int.Parse(json["durationMs"].ToString()), 0, 250);
+            int frequency = Mathf.Clamp(int.Parse(json["frequencyHz"].ToString()), 50, 500);
+            SendHaptic(PXR_Input.VibrateType.LeftController, left, duration, frequency);
+            SendHaptic(PXR_Input.VibrateType.RightController, right, duration, frequency);
+        }
+        catch (Exception e)
+        {
+            Debug.LogError("HapticImpulse: " + e.Message);
+        }
+    }
+
+    private static void SendHaptic(
+        PXR_Input.VibrateType controller,
+        float amplitude,
+        int durationMs,
+        int frequencyHz)
+    {
+        if (amplitude <= 0)
+        {
+            return;
+        }
+
+        PXR_Input.SendHapticImpulse(controller, amplitude, durationMs, frequencyHz);
+        Debug.Log($"HapticImpulse {controller}: amplitude={amplitude:0.00}");
+    }
+}
