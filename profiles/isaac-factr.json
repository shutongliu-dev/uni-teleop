{
  "description": "FACTR 七轴关节映射 → Franka；主臂扳机控制手",
  "cwd": "${ROOT}/vendor/dexbench",
  "command": [
    "bash",
    "${ROOT}/vendor/dexbench/scripts/teleop/run_master_slave.sh",
    "--workbench-only",
    "--physics-profile",
    "cpu_rigid_v1",
    "--no-task-scoring",
    "--practice-contact-warnings",
    "--profile",
    "--leader-port",
    "${FACTR_PORT}",
    "--arm-calibration",
    "${FACTR_CALIBRATION}",
    "--no-video"
  ],
  "env": {
    "DEXBENCH_PYTHON": "${DEXBENCH_PYTHON}",
    "DEXBENCH_DATA": "${DEXBENCH_DATA}",
    "DEXBENCH_RUNS": "${ROOT}/runs/isaac",
    "ISAAC_PYTHON_LAUNCHER": "${ISAAC_PYTHON_LAUNCHER}",
    "CUDA_VISIBLE_DEVICES": "${CUDA_VISIBLE_DEVICES}",
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1"
  },
  "checks": [
    [
      "${DEXBENCH_PYTHON}",
      "executable"
    ],
    [
      "${DEXBENCH_DATA}/MANIFEST.json",
      "file"
    ],
    [
      "${ISAAC_PYTHON_LAUNCHER}",
      "executable"
    ],
    [
      "${FACTR_PORT}",
      "exists"
    ],
    [
      "${FACTR_CALIBRATION}",
      "file"
    ]
  ]
}
